# ==============================================================================
# AMAZON-API-APPS — PLANTILLA DE CONFIGURACIÓN DE ENTORNO (.env.example)
# ==============================================================================
# Instrucciones:
# 1. Copia este archivo como '.env':
#      cp .env.example .env     (Linux / macOS)
#      copy .env.example .env   (Windows PowerShell: Copy-Item .env.example .env)
# 2. Rellena los valores con tus credenciales obtenidas de los portales oficiales.
# 3. NUNCA subas tu archivo '.env' a ningún repositorio público o control de versiones.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. AMAZON CREATORS API v3.2 / LWA (Login With Amazon)
# ------------------------------------------------------------------------------
# Necesario para consultar el catálogo, buscar ofertas y obtener datos de productos.
# Obtenido desde el portal de Amazon Associates / Creators API:
# https://affiliate-program.amazon.es / https://developer.amazon.com
AMAZON_CLIENT_ID=amzn1.application-oa2-client.tu_client_id_aqui
AMAZON_CLIENT_SECRET=tu_client_secret_lwa_aqui
AMAZON_AFFILIATE_TAG=tu_tag_afiliado-21
AMAZON_MARKETPLACE=www.amazon.es
AMAZON_API_VERSION=3.2
AMAZON_AUTH_ENDPOINT=https://api.amazon.co.uk/auth/o2/token
AMAZON_OAUTH_SCOPE=creatorsapi::default

# ------------------------------------------------------------------------------
# 2. OPENAI API (Generación de Copywriting y Categorización)
# ------------------------------------------------------------------------------
# Utilizado por GPTService para redactar textos persuasivos de venta y asignar hashtags.
# Obtén tu clave en: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-proj-tu_openai_api_key_aqui

# ------------------------------------------------------------------------------
# 3. TELEGRAM BOT API (Publicación de Mensajes)
# ------------------------------------------------------------------------------
# Necesario para enviar publicaciones con foto y texto formateado a tus canales/grupos.
# Crea tu bot con @BotFather en Telegram: https://t.me/BotFather
TELEGRAM_BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrSTUvwxYZ_tu_bot_token

# ID numérico del canal o grupo donde se envían las ofertas para revisión/administración
TELEGRAM_ADMIN_CHANNEL_ID=-1001234567890

# ID numérico del canal público principal donde se publican los chollos definitivos
TELEGRAM_MAIN_CHANNEL_ID=-1001234567890

# ------------------------------------------------------------------------------
# 4. TELEGRAM USER API (Telethon / MTProto - Lector de Histórico)
# ------------------------------------------------------------------------------
# Opcional / Herramientas CLI: Permite leer el historial de canales para sincronizar
# categorías y hashtags existentes.
# Obtenido en: https://my.telegram.org/apps
TELEGRAM_USER_API_ID=12345678
TELEGRAM_USER_API_HASH=tu_api_hash_telethon_aqui
TELEGRAM_USER_SESSION=runtime/telegram_user

# ------------------------------------------------------------------------------
# 5. KEEPA API (Histórico de Precios y Validación de Descuento Real)
# ------------------------------------------------------------------------------
# Opcional (Servicio de pago): Permite auditar si una oferta es un descuento real
# o un señuelo artificial frente al histórico de 90 días de Amazon.
# Deja vacío si no dispones de suscripción de pago (el buscador seguirá funcionando).
# Obtén tu clave en: https://keepa.com/#!api
KEEPA_API_KEY=

# ------------------------------------------------------------------------------
# 6. SERVIDOR Y RUTAS LOCALES
# ------------------------------------------------------------------------------
# Dirección del servidor FastAPI (NAS / Docker / Local)
NAS_SERVER_URL=http://localhost:8000

# Ruta relativa o absoluta al catálogo local de categorías JSON
CATEGORIES_FILE_PATH=data/categories.json
